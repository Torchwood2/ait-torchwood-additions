{
  "schemaVersion": 1,
  "id": "ata",
  "version": "${version}",
  "name": "ATA",
  "description": "An Adventures in Time addon adding sonics, interiors, desktops, exteriors and decorative blocks.",
  "authors": [],
  "contact": {
    "repo": "https://github.com/james/ata"
  },
  "license": "Apache-2.0",
  "icon": "assets/ata/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "uk.jacobempire.ata.ATA"
    ],
    "client": [
      "uk.jacobempire.ata.client.ATAClient"
    ]
  },
  "mixins": [
    "ata.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=17",
    "fabric-api": "*",
    "ait": ">=1.2.12-beta",
    "amblekit": ">=1.1.14-1.20.1-beta",
    "yet_another_config_lib_v3": ">=3.6.1+1.20.1-fabric",
    "supplementaries": "*",
    "amendments": "*"
  },
  "suggests": {
    "gallifrey": "*"
  }
}