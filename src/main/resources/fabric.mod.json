{
  "schemaVersion": 1,
  "id": "ata",
  "version": "${version}",
  "name": "ATA",
  "description": "An Adventures in Time addon adding sonics, interiors, desktops, exteriors and decorative blocks.",
  "authors": [],
  "contact": {
    "repo": "https://github.com/james/ata"
  },
  "license": "Apache-2.0",
  "icon": "assets/ata/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "uk.jacobempire.ata.client.ATAClient"
    ],
    "main": [
      "uk.jacobempire.ata.ATA"
    ],
    "fabric-datagen": [
      "uk.jacobempire.ata.datagen.ExtrasDataGenerator"
    ]
  },
  "mixins": [
    "ata.mixins.json"
  ],
  "depends": {
    "ait": "*",
    "amblekit": "*",
    "yet_another_config_lib_v3": "*",
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}"
  }
}
